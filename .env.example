# Environment template for hindsight-memorial.
#
# Copy to .env on the deployment host and fill in real values. .env is in
# .gitignore for the project; this .env.example file is the canonical
# documentation of which keys are required.
#
# Required:
#   HINDSIGHT_API_KEY        — must match the value used by the hindsight
#                              container (look in /www/dk_project/dk_app/hindsight/.env)
#   HINDSIGHT_WEBHOOK_SECRET — generate with `openssl rand -hex 32`. The same
#                              string must be configured in the Hindsight
#                              webhooks UI when creating the webhook.
#
# The compose file sets HINDSIGHT_API_URL and HINDSIGHT_MEMORIAL_LOG_FILE
# directly, so they should NOT be set here (or if they are, the compose
# values win for the container).

# --- required ---
HINDSIGHT_API_KEY=replace-with-the-same-value-the-hindsight-container-uses
HINDSIGHT_WEBHOOK_SECRET=replace-with-output-of-openssl-rand-hex-32

# --- persistence backend (optional, defaults to in-memory SQLite) ---
# Set HINDSIGHT_MYSQL_HOST to enable MySQL. The other keys are read
# only when HINDSIGHT_MYSQL_HOST is set. The deployment points at the
# host's existing MySQL: `host.docker.internal` resolves to the docker
# bridge gateway via the compose `extra_hosts` entry, and the host's ufw
# must allow the hindsight_default subnet (172.23.0.0/16) to reach 3306.
# Leave HINDSIGHT_MYSQL_HOST unset for the SQLite "ingest-only" mode.
#
# For first-time provisioning of the database, see sql/00_bootstrap.sql
# (root) → sql/01_create_db.sql (memorial) → sql/02_schema.sql (memorial).
# sql/99_smoke_test.sql is the post-deploy health check.
HINDSIGHT_MYSQL_HOST=host.docker.internal
HINDSIGHT_MYSQL_PORT=3306
HINDSIGHT_MYSQL_USER=memorial
HINDSIGHT_MYSQL_PASSWORD=replace-with-the-memorial-user-password
HINDSIGHT_MYSQL_DATABASE=hindsight_memorial

# --- poller (optional) ---
# HINDSIGHT_POLLER_ENABLED=0  → ingest-only mode (no reflect/curate)
# HINDSIGHT_POLLER_INTERVAL_SEC=1  → empty-queue poll interval
HINDSIGHT_POLLER_ENABLED=1
HINDSIGHT_POLLER_INTERVAL_SEC=1